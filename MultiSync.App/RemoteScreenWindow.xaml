<Window x:Class="MultiSync.App.RemoteScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiSync — Tela Remota"
        Width="1040" Height="640"
        MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#07090E"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewKeyUp="OnWindowPreviewKeyUp">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2636"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#313E57"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B374F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1E2636"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#313E57"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border x:Name="TopToolbar" Grid.Row="0" Background="#121722" BorderBrush="#242E42" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText" Text="🖥️ Tela Remota" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border x:Name="StreamBadge" Background="#1F2937" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StreamStatsText" Text="Conectando..." FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="QualityCombo" Width="154" Height="26" Margin="0,0,8,0"
                              FontSize="11.5" SelectedIndex="0"
                              SelectionChanged="OnQualitySelectionChanged">
                        <ComboBoxItem Content="720p • 30 FPS (Padrão)"/>
                        <ComboBoxItem Content="1080p • 30 FPS (Nítido)"/>
                        <ComboBoxItem Content="720p • 60 FPS (Suave)"/>
                        <ComboBoxItem Content="1080p • 60 FPS (Ultra)"/>
                    </ComboBox>

                    <ToggleButton x:Name="ControlToggle" Content="🖱️ Controlar aqui" Style="{StaticResource ToolbarToggle}"
                                  Margin="0,0,6,0" ToolTip="Permite clicar, rolar e digitar direto dentro desta janela"
                                  Click="OnControlToggleClick"/>

                    <ToggleButton x:Name="TopmostToggle" Content="📌 PiP (Topo)" Style="{StaticResource ToolbarToggle}"
                                  Margin="0,0,6,0" ToolTip="Mantém esta janela sempre visível por cima das outras"
                                  Click="OnTopmostToggleClick"/>

                    <Button x:Name="FullscreenButton" Content="⛶ Tela Cheia" Style="{StaticResource ToolbarButton}"
                            ToolTip="Alterna Tela Cheia (F11 / Esc para sair)"
                            Click="OnFullscreenClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LIVE VIDEO SURFACE + DRAG & DROP OVERLAY -->
        <Grid Grid.Row="1" Background="#05070B">
            <Image x:Name="ScreenImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseMove="OnScreenMouseMove"
                   MouseDown="OnScreenMouseDown"
                   MouseUp="OnScreenMouseUp"
                   MouseWheel="OnScreenMouseWheel"/>

            <TextBlock x:Name="ConnectingOverlayText"
                       Text="Conectando à tela remota..."
                       FontSize="15" FontWeight="SemiBold" Foreground="#9CA3AF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border x:Name="DropOverlay"
                    Visibility="Collapsed"
                    Background="#CC0F172A"
                    BorderBrush="#38BDF8"
                    BorderThickness="3"
                    CornerRadius="12"
                    Margin="24"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📂" FontSize="44" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DropOverlayText"
                               Text="Solte aqui para enviar arquivos para o outro PC"
                               FontSize="18" FontWeight="Bold" Foreground="#E0F2FE" Margin="0,8,0,0"/>
                    <TextBlock Text="Transferência rápida via rede local (256 KB/bloco)"
                               FontSize="12" Foreground="#93C5FD" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- COMPACT FOOTER -->
        <Border x:Name="BottomBar" Grid.Row="2" Background="#121722" BorderBrush="#242E42" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterInfoText" Grid.Column="0"
                           Text="Dica: você pode arrastar e soltar arquivos/pastas direto nesta janela para enviar ao outro PC."
                           FontSize="11.5" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                <TextBlock x:Name="HintShortcutText" Grid.Column="1"
                           Text="F11: Tela Cheia"
                           FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
