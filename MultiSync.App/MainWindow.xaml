<Window x:Class="MultiSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiSync — Controle Multi-PC &amp; Layout Visual"
        Width="1160" Height="740"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0D1017"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#242C3D"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#344059"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3A52"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1017"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="CaretBrush" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#2E384D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="#151A24" BorderBrush="#252E42" BorderThickness="1" CornerRadius="10" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#2563EB" Margin="0,0,12,0">
                        <TextBlock Text="⇄" FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MultiSync" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <Border x:Name="EngineBadge" Background="#064E3B" CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="EngineStatusText" Text="Ativo" FontSize="11.5" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LocalMachineInfoText" Text="Este PC: ..." FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- PIN DISPLAY -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#0D1017" BorderBrush="#2A3347" BorderThickness="1" CornerRadius="8" Padding="14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PIN deste PC:" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PinCodeText" Text="----" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Novo PIN" Style="{StaticResource ModernButton}" Padding="8,3" FontSize="11"
                                Click="OnRegeneratePinClick"/>
                    </StackPanel>
                </Border>

                <!-- HEADER OPTIONS -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="FullscreenGuardCheck"
                              Content="Bloquear em Tela Cheia (Jogos)"
                              Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,14,0"
                              IsChecked="True"
                              Click="OnFullscreenGuardChanged"/>
                    <CheckBox x:Name="AutoStartCheck"
                              Content="Iniciar com Windows"
                              Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,14,0"
                              Click="OnAutoStartChanged"/>
                    <Button Content="Liberar Firewall" Style="{StaticResource ModernButton}"
                            ToolTip="Libera as portas TCP 5050, UDP 5051 e TCP 5052 na rede local"
                            Click="OnOpenFirewallClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: VISUAL DRAG & DROP MONITOR CANVAS -->
            <Border Grid.Column="0" Background="#151A24" BorderBrush="#252E42" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Layout das Telas &amp; Controle Master / Slave" FontSize="14.5" FontWeight="Bold"/>
                            <TextBlock Text="Arraste os monitores para escolher o lado (Esquerda, Direita, Acima, Abaixo) e defina quem é o Master."
                                       FontSize="11.5" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⇄ Inverter Master / Slave" Style="{StaticResource ModernButton}" Margin="0,0,8,0"
                                    Click="OnSwapMasterSlaveClick"/>
                            <Button Content="⌖ Centralizar" Style="{StaticResource ModernButton}"
                                    Click="OnRecenterCanvasClick"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#0A0D13" BorderBrush="#1F2737" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Canvas x:Name="MonitorCanvas"
                                Background="Transparent"
                                SizeChanged="OnMonitorCanvasSizeChanged"
                                MouseMove="OnCanvasMouseMove"
                                MouseLeftButtonUp="OnCanvasMouseLeftButtonUp"
                                MouseLeave="OnCanvasMouseLeave"/>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="LayoutSummaryText" Text="Layout: ..." FontSize="12.5" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                            <TextBlock x:Name="UnsavedHintText" Text="Alterações pendentes — clique em Aplicar para sincronizar os computadores."
                                       FontSize="11.5" Foreground="#FBBF24" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="ApplyLayoutButton" Grid.Column="1"
                                Content="✓ Aplicar nos Computadores"
                                Style="{StaticResource PrimaryButton}"
                                Padding="18,9" FontSize="13"
                                Click="OnApplyLayoutClick"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: LAN DISCOVERY & PAIRING -->
            <Border Grid.Column="2" Background="#151A24" BorderBrush="#252E42" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dispositivos na Rede (LAN)" FontSize="14.5" FontWeight="Bold"/>
                            <TextBlock Text="Identificados automaticamente na rede local" FontSize="11.5" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="↻ Buscar" Style="{StaticResource ModernButton}" Padding="10,5"
                                Click="OnScanLanClick"/>
                    </Grid>

                    <Border Grid.Row="2" Background="#0E121B" BorderBrush="#1F2737" BorderThickness="1" CornerRadius="8" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LanDevicesStack"/>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="4" Background="#101520" BorderBrush="#232C3F" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Parear por IP Manual (opcional)" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ManualIpBox" Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                         ToolTip="IP do outro PC (ex: 192.168.2.6)" Text="192.168.2."/>
                                <TextBox x:Name="ManualPinBox" Grid.Column="2" Style="{StaticResource ModernTextBox}"
                                         MaxLength="4" ToolTip="PIN de 4 dígitos exibido no outro PC"/>
                                <Button Grid.Column="4" Content="Parear" Style="{StaticResource PrimaryButton}" Padding="12,5"
                                        Click="OnManualPairClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER STATUS -->
        <Border Grid.Row="4" Background="#151A24" BorderBrush="#252E42" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FeedbackStatusText" Grid.Column="0"
                           Text="Pronto. Atalhos globais: Ctrl+Alt+Win+L (travar tela)  •  Ctrl+Alt+Win+Setas (mudar de tela)."
                           FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                <TextBlock x:Name="LatencyText" Grid.Column="1" Text="" FontSize="12" FontWeight="SemiBold"
                           Foreground="#10B981" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
